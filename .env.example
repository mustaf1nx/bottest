# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# База данных (опционально):
# Для SQLite: sqlite:////data/bot.sqlite3 (или sqlite:///bot.sqlite3)
# Для PostgreSQL: postgresql://postgres:password@localhost:5432/botdb
# Если не указана, бот работает на JSON-файлах
DATABASE_URL=sqlite:////data/bot.sqlite3

# Список ID главных администраторов через запятую
ADMIN_USER_IDS=

# Настройки марковской генерации
MARKOV_ORDER=2
MAX_GREETING_WORDS=28

# Настройки инвайтов
INVITE_TTL_SECONDS=900
INVITE_HOURLY_LIMIT=5
INVITE_GROUP_FALLBACK=true

# Опционально: добавление через юзербота (Telethon)
# TELETHON_API_ID=
# TELETHON_API_HASH=
# TELETHON_SESSION=
